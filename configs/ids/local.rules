# Custom Snort IDS Rules - VNA Project
# Author: Alirizo Axmedov (2426806)
# Install at: /etc/snort/rules/local.rules
 
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"PORT SCAN SYN DETECTED"; flags:S; threshold:type both, track by_src, count 10, seconds 1; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"SSH BRUTE FORCE DETECTED"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"ICMP FLOOD DETECTED"; threshold:type both, track by_src, count 20, seconds 1; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP DIRECTORY TRAVERSAL ATTEMPT"; content:"../"; sid:1000004; rev:1;)
